{
  "name": "@threadmind/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --env-file-if-exists=../.env --watch --import=tsx src/api/main.ts",
    "start": "node --env-file-if-exists=../.env dist/src/api/main.js",
    "test": "npm run build --silent && node --test dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "fastify": "^5.6.0",
    "jose": "^6.2.10",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "4.23.12",
    "typescript": "^5.9.0"
  }
}
