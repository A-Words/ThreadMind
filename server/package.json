{
  "name": "@threadmind/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --env-file-if-exists=../.env --watch --import=tsx src/api/main.ts",
    "dev:worker": "node --env-file-if-exists=../.env --watch --import=tsx src/worker/main.ts",
    "start": "node --env-file-if-exists=../.env dist/src/api/main.js",
    "start:worker": "node --env-file-if-exists=../.env dist/src/worker/main.js",
    "test": "npm run build --silent && node --test dist/test/*.test.js",
    "test:integration": "npm run build --silent && node --env-file-if-exists=../.env --test dist/test/postgres.integration.test.js",
    "test:history-integration": "npm run build --silent && node --env-file-if-exists=../.env --test dist/test/submission-history.integration.js",
    "test:recall-integration": "npm run build --silent && node --env-file-if-exists=../.env --test dist/test/memory-recall.integration.js",
    "test:insight-model": "npm run build --silent && node --env-file-if-exists=../.env scripts/smoke-insight.mjs",
    "test:insight-quality": "npm run build --silent && node --env-file-if-exists=../.env scripts/evaluate-insight-quality.mjs",
    "dev:real-e2e": "npm run build --silent && node --env-file-if-exists=../.env scripts/local-agent-e2e-server.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.1",
    "@langchain/core": "1.2.9",
    "@langchain/langgraph": "1.4.13",
    "@supabase/supabase-js": "2.112.4",
    "fastify": "^5.6.0",
    "jose": "^6.2.10",
    "kysely": "0.29.5",
    "pg": "8.23.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "8.23.1",
    "tsx": "4.23.12",
    "typescript": "^5.9.0"
  }
}
