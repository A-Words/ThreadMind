PORT=3000
AUTH_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
AUTH_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1
AUTH_AUDIENCE=authenticated
DATABASE_URL=postgresql://threadmind_runtime.YOUR_PROJECT:YOUR_PASSWORD@YOUR_SESSION_POOLER:5432/postgres
DATABASE_POOL_MAX=5
DATABASE_SSL_REJECT_UNAUTHORIZED=true
THREADMIND_E2E_ACCOUNT_ID=YOUR_AUTH_USER_UUID
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_YOUR_SERVER_ONLY_KEY
SUPABASE_STORAGE_BUCKET=threadmind-submissions
OPENAI_API_KEY=YOUR_SERVER_ONLY_OPENAI_KEY
THREADMIND_VISION_MODEL=YOUR_EVALUATED_VISION_MODEL
OPENAI_BASE_URL=https://api.openai.com/v1
THREADMIND_MODEL_TIMEOUT_MS=60000
THREADMIND_MODEL_MAX_OUTPUT_TOKENS=12000
